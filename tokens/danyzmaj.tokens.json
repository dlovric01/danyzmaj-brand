{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": "danyzmaj",
  "color": {
    "ink": {
      "$value": "#171210",
      "$description": "primary ground, warm iron-oxide black"
    },
    "inkRaised": {
      "$value": "#221A17",
      "$description": "raised region on the press bed"
    },
    "inkSunk": {
      "$value": "#100C0A",
      "$description": "recessed region, page edges"
    },
    "cinnabar": {
      "$value": "#DA3A20",
      "$description": "stamp ink. mark + display type only. 4.08:1 on ink"
    },
    "cinnabarStruck": {
      "$value": "#B32B15",
      "$description": "pressed state of cinnabar"
    },
    "oxideHover": {
      "$value": "#A0230F",
      "$description": "oxide one step warmer, for hover on an oxide field"
    },
    "errorText": {
      "$value": "#F08A72",
      "$description": "oxide tinted up for error copy. 6.99:1 on ink-raised"
    },
    "oxide": {
      "$value": "#8E1F0E",
      "$description": "text-safe red. 7.66:1 against bone, both directions"
    },
    "brass": {
      "$value": "#C08A2E",
      "$description": "hairlines, small-caps labels, metadata. 6.12:1 on ink"
    },
    "bone": {
      "$value": "#F2EDE4",
      "$description": "paper, primary text on dark. 15.93:1 on ink"
    },
    "boneDim": {
      "$value": "#CFC4B4",
      "$description": "secondary text on dark. 10.80:1 on ink"
    },
    "ash": {
      "$value": "#948881",
      "$description": "tertiary text on dark, contrast floor. 5.39:1 on ink"
    }
  },
  "contrast": {
    "boneOnInk": 15.93,
    "boneDimOnInk": 10.8,
    "ashOnInk": 5.39,
    "brassOnInk": 6.12,
    "cinnabarOnInk": 4.08,
    "inkOnBone": 15.93,
    "oxideOnBone": 7.66,
    "boneOnOxide": 7.66,
    "note": "cinnabar fails 4.5:1 for body copy in both directions. display type and marks only.",
    "cinnabarOnBone": 3.91,
    "ashOnInkRaised": 4.97
  },
  "role": {
    "surface": "color.ink",
    "surfaceRaised": "color.inkRaised",
    "surfaceSheet": "color.bone",
    "text": "color.bone",
    "textMuted": "color.boneDim",
    "textMeta": "color.ash",
    "textOnSheet": "color.ink",
    "accent": "color.cinnabar",
    "accentText": "color.oxide",
    "rule": "color.brass @ 46%",
    "ruleStrong": "color.brass",
    "$description": "semantic layer over the primitives; retarget here, not at call sites"
  },
  "font": {
    "display": {
      "$value": "Bodoni Moda",
      "fallback": [
        "Didot",
        "Bodoni 72",
        "Times New Roman",
        "serif"
      ],
      "axes": {
        "opsz": [
          6,
          96
        ],
        "wght": [
          400,
          900
        ]
      }
    },
    "text": {
      "$value": "Archivo",
      "fallback": [
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": "JetBrains Mono",
      "fallback": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ],
      "$description": "code, tokens and measurements only. never decorative"
    }
  },
  "type": {
    "trackingDisplay": {
      "$value": "-0.022em"
    },
    "trackingLabel": {
      "$value": "0.16em",
      "$description": "small-caps labels only"
    },
    "leadingDisplay": {
      "$value": 0.92
    },
    "leadingText": {
      "$value": 1.62
    },
    "measure": {
      "$value": "68ch",
      "$description": "body measure ceiling"
    }
  },
  "size": {
    "display1": "clamp(2.85rem, 8.4vw, 6rem)",
    "display2": "clamp(2rem, 4.6vw, 3.4rem)",
    "display3": "clamp(1.45rem, 2.8vw, 2.1rem)",
    "lg": "1.1875rem",
    "base": "1rem",
    "sm": "0.8125rem",
    "xs": "0.75rem"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem",
    "9": "6rem",
    "10": "8rem"
  },
  "border": {
    "hairline": {
      "$value": "1px",
      "$description": "every border in the system"
    }
  },
  "radius": {
    "default": 0,
    "iconRatio": 0.2,
    "seal": "50%",
    "$description": "struck geometry: nothing is rounded except the seal and app-icon container"
  },
  "shadow": {
    "strike": "0 2px 0 rgb(0 0 0 / 0.55), 0 18px 40px -14px rgb(0 0 0 / 0.7)",
    "sheet": "0 1px 0 rgb(0 0 0 / 0.4), 0 28px 60px -22px rgb(0 0 0 / 0.75)",
    "filterStrike": "drop-shadow(0 2px 0 rgb(0 0 0 / 0.55)) drop-shadow(0 14px 22px rgb(0 0 0 / 0.5))"
  },
  "motion": {
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "tap": "180ms",
    "move": "320ms",
    "strike": "620ms"
  },
  "logo": {
    "cuts": {
      "primary": {
        "file": "logo/mark.svg",
        "minSize": "96px",
        "detail": "full crest, nostril, fang"
      },
      "small": {
        "file": "logo/mark-small.svg",
        "minSize": "40px",
        "detail": "3 crest spikes, no nostril or fang"
      },
      "tiny": {
        "file": "logo/mark-tiny.svg",
        "minSize": "16px",
        "detail": "2 crest spikes, heaviest body"
      }
    },
    "clearspace": "0.25 x mark height on all four sides",
    "seal": {
      "file": "logo/seal.svg",
      "minSize": "96px"
    }
  }
}
